FROM node:22-alpine AS deps

WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

FROM deps AS dev

WORKDIR /app
EXPOSE 14321

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "14321"]

# Static export (GitHub Pages / offline preview). Bootstrap PUBLIC_* only —
# model/tutor/prompt/voice come from GET /v1/soju/config/client (or config.ts fallbacks).
# Defaults suit a public static host (AI off, browser TTS, site at /).
# Example:
#   docker build -f docker/Dockerfile.web --target build \
#     --build-arg PUBLIC_BASE_PATH=/soju-platform \
#     -t soju-web:static .
# Or: scripts/docker-build-web.sh [extract-dir]
FROM deps AS build

WORKDIR /app

COPY apps/web/ ./
COPY data/ /data/

ARG PUBLIC_BASE_PATH=
ARG PUBLIC_TTS_ENGINE=browser
ARG PUBLIC_AI_ENABLED=false
ARG PUBLIC_AI_BASE_URL=/api

ENV DATA_DIR=/data

RUN npm run build
